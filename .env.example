# Kopieren nach .env.local und ausfüllen. .env.local nie committen.

# Hauptdomain ohne Protokoll. Lokal: coachlab.localhost:3000, Produktion: coachlab.com
NEXT_PUBLIC_ROOT_DOMAIN=coachlab.localhost:3000

# Supabase – lokal: Werte aus `npm run db:start`.
# Produktion: Supabase-Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Geheim! Nur serverseitig (Webhooks, Wartung). Nie mit NEXT_PUBLIC_ beginnen.
SUPABASE_SECRET_KEY=

# Stripe – geheim, nur serverseitig. Empfohlen: eingeschränkter Key (rk_test_… / rk_live_…).
# Lokal Webhooks: `stripe listen --forward-to localhost:3000/api/stripe/webhook` liefert whsec_….
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (E-Mails, ab Phase 1)
RESEND_API_KEY=
